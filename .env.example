# ─── Copy this file to .env and fill in real values ──────────────────────────
# cp .env.example .env

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=emailuser
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=emailplatform
DATABASE_URL=postgresql://emailuser:CHANGE_ME_STRONG_PASSWORD@db:5432/emailplatform

# ── Redis / Celery ────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ── SMTP Outbound Identity ────────────────────────────────────────────────────
# Your Contabo additional static IP (used to bind outbound SMTP connections)
# Leave empty to let OS pick the default interface (less reliable for verification)
SMTP_SOURCE_IP=169.58.234.98

# The "MAIL FROM" address sent during SMTP handshake
SMTP_VERIFICATION_FROM=verify@mail.yourdomain.com

# The "EHLO/HELO" hostname (should match PTR record of SMTP_SOURCE_IP)
SMTP_HELO_HOST=mail.yourdomain.com

# ── Rate Limiting (Contabo-safe sequential SMTP) ──────────────────────────────
# Seconds to wait between each SMTP check in bulk jobs.
# Jitter = random value between MIN and MAX.
# DO NOT set MIN < 1.0 — risk of IP ban from mail servers.
SMTP_DELAY_MIN=1.2
SMTP_DELAY_MAX=2.8
